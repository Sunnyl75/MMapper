# The compressed source keeps the terrain file out of generated C++ sources in Git.
# Qt embeds the expanded XML as a compressed resource for all deployment targets.
function(mmapper_prepare_background_resource output_variable)
    set(resource_dir "${PROJECT_SOURCE_DIR}/src/resources/maps")
    set(archive "${resource_dir}/background-terrain.tar.gz")
    set(metadata "${resource_dir}/background-terrain.json")
    set(BUNDLED_BACKGROUND_MAP_METADATA "${metadata}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${archive}" "${metadata}")
    file(READ "${metadata}" manifest)
    string(JSON expected_archive GET "${manifest}" archive_sha256)
    string(JSON expected_map GET "${manifest}" map_sha256)
    file(SHA256 "${archive}" actual_archive)
    if(NOT actual_archive STREQUAL expected_archive)
        message(FATAL_ERROR "Bundled background archive checksum mismatch")
    endif()
    set(destination "${PROJECT_BINARY_DIR}/bundled-background")
    set(BUNDLED_BACKGROUND_MAP_FILE "${destination}/background-terrain.mm2xml")
    if(EXISTS "${BUNDLED_BACKGROUND_MAP_FILE}")
        file(SHA256 "${BUNDLED_BACKGROUND_MAP_FILE}" actual_map)
    endif()
    if(NOT actual_map STREQUAL expected_map)
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${destination}")
        file(SHA256 "${BUNDLED_BACKGROUND_MAP_FILE}" actual_map)
        if(NOT actual_map STREQUAL expected_map)
            message(FATAL_ERROR "Bundled background terrain checksum mismatch")
        endif()
    endif()
    set(qrc "${CMAKE_CURRENT_BINARY_DIR}/background-map.qrc")
    configure_file("${PROJECT_SOURCE_DIR}/src/resources/background-map.qrc.in" "${qrc}" @ONLY)
    set(${output_variable} "${qrc}" PARENT_SCOPE)
endfunction()
